# Modelos grandes (reproducibles con el código; el router entrenado sí se incluye)
models/*.irmdl
models/*.ukj
*.irmdl
*.ukj

# Fixtures diminutos del runtime: los tests los necesitan y pesan <1 MB
!runtime/assets/test.ukj
!runtime/assets/tiny.ukj
!runtime/assets/tiny.ukj.json

# Datos descargados
datos/buffer/
datos/cursors/
datos/*.json

# Rust
runtime/target/
src/rust/ukj_reader/target/

# Python
__pycache__/
*.pyc
.venv/

# Binarios compilados
*.exe
*.o
*.obj
*.pdb

# Temporales
*.tmp

# Build
/target
**/*.rs.bk

# Estado generado en tiempo de ejecución
/memory/
*.mem
*.mem.zst
/feedback_queue.jsonl
*.stress.json

# Entorno
.env
Manifest.toml
